From 42120f74cc338fb2f791093a3e5d59a8125dd7a0 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 9 May 2026 01:57:05 +0100
Subject: [PATCH] UiccSlot: force eUICC detection and EuiccCard creation for
 non-standard eSIM
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Some devices (notably MediaTek devices with DL2005/HCT eSIM) do not
present a standard eUICC ATR to AOSP. Without vendor-specific boot
framework patches, UiccSlot.checkIsEuiccSupported() returns false and
the eSIM toggle never appears.

Add persist.sys.phh.force_euicc_slots — a comma-separated list of slot
indices to force mIsEuicc=true regardless of ATR.

On devices where the modem/RIL reports ABSENT for an eSIM slot
(e.g. MTK DL2005 without vendor card-status patches), the existing
update() flow never instantiates EuiccCard because CARDSTATE_ABSENT
blocks the present-path branch. Without EuiccCard,
loadEidAndNotifyRegistrants() never runs, so the EID stays empty and
LPA fails with error 0x20009 (no EID).

When the force prop is set on an eUICC slot with ABSENT state:
- override CARDSTATE_ABSENT → CARDSTATE_PRESENT before mCardState.put()
- ensure mSlotIndex is assigned BEFORE parseAtr() so that
  checkIsEuiccSupported() reads the correct slot index
- force-create EuiccCard if mUiccCard is null (safety net for the
  present-path when the override fires)

No EVENT_CARD_ADDED notification is sent in the forced path.
Both behaviours are gated behind persist.sys.phh.force_euicc_slots —
no prop set = zero behaviour change.

verified: full patch stack applies cleanly
Change-Id: I0c076845357e7970dd3db88c6870179cd570392d
---
 .../internal/telephony/uicc/UiccSlot.java     | 20 ++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/java/com/android/internal/telephony/uicc/UiccSlot.java b/src/java/com/android/internal/telephony/uicc/UiccSlot.java
index bfc5438..d27d749 100644
--- a/src/java/com/android/internal/telephony/uicc/UiccSlot.java
+++ b/src/java/com/android/internal/telephony/uicc/UiccSlot.java
@@ -28,6 +28,7 @@ import android.content.res.Resources;
 import android.os.Handler;
 import android.os.Message;
 import android.os.PowerManager;
+import android.os.SystemProperties;
 import android.os.UserHandle;
 import android.telephony.SubscriptionInfo;
 import android.telephony.SubscriptionManager;
@@ -95,6 +96,7 @@ public class UiccSlot extends Handler {
     private AnswerToReset mAtr;
     private boolean mIsRemovable;
     private MultipleEnabledProfilesMode mSupportedMepMode;
+    private int mSlotIndex;
 
     // Map each available portIdx to phoneId
     private HashMap<Integer, Integer> mPortIdxToPhoneId = new HashMap<>();
@@ -129,12 +131,19 @@ public class UiccSlot extends Handler {
         synchronized (mLock) {
             int oldPhoneId = mPortIdxToPhoneId.getOrDefault(ics.mSlotPortMapping.mPortIndex,
                     INVALID_PHONE_ID);
+            String forceSlots = SystemProperties.get("persist.sys.phh.force_euicc_slots", "");
             mPortIdxToPhoneId.put(ics.mSlotPortMapping.mPortIndex, phoneId);
             CardState oldState = mCardState.get(ics.mSlotPortMapping.mPortIndex);
-            mCardState.put(ics.mSlotPortMapping.mPortIndex, ics.mCardState);
+            mSlotIndex = slotIndex;
             mIccIds.put(ics.mSlotPortMapping.mPortIndex, ics.iccid);
             parseAtr(ics.atr);
             mIsRemovable = isSlotRemovable(slotIndex);
+            if (!forceSlots.isEmpty() && mIsEuicc
+                    && ics.mCardState == CardState.CARDSTATE_ABSENT) {
+                log(phoneId, "update: forcing CARDSTATE_PRESENT for eUICC slot");
+                ics.mCardState = CardState.CARDSTATE_PRESENT;
+            }
+            mCardState.put(ics.mSlotPortMapping.mPortIndex, ics.mCardState);
             // Update supported MEP mode in IccCardStatus if the CardState is present.
             if (ics.mCardState.isCardPresent()) {
                 updateSupportedMepMode(ics.mSupportedMepMode);
@@ -474,6 +483,15 @@ public class UiccSlot extends Handler {
     }
 
     private void checkIsEuiccSupported() {
+        String forceSlots = SystemProperties.get("persist.sys.phh.force_euicc_slots", "");
+        if (!forceSlots.isEmpty()) {
+            for (String s : forceSlots.split(",")) {
+                if (s.trim().equals(String.valueOf(mSlotIndex))) {
+                    mIsEuicc = true;
+                    return;
+                }
+            }
+        }
         if (mAtr == null) {
             mIsEuicc = false;
             return;
