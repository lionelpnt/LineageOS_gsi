From 76abb10ccaf9599d567b049937cd420167ce14b2 Mon Sep 17 00:00:00 2001
From: lionelpnt <lionelpnt@users.noreply.github.com>
Date: Thu, 26 Nov 2026 15:13:55 +0100
Subject: [PATCH] lineage: configure Wi-Fi-only tablet target for bgN4

---
 lineage.mk            | 4 +---
 lineage_arm64_bgN4.mk | 2 +-
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/lineage.mk b/lineage.mk
index 527e4a1..764c2a1 100644
--- a/lineage.mk
+++ b/lineage.mk
@@ -1,4 +1,4 @@
-$(call inherit-product, vendor/lineage/config/common_full_phone.mk)
+$(call inherit-product, vendor/lineage/config/common_full_tablet_wifionly.mk)
 $(call inherit-product, vendor/lineage/config/BoardConfigSoong.mk)
 $(call inherit-product, vendor/lineage/config/BoardConfigLineage.mk)
 $(call inherit-product, device/lineage/sepolicy/common/sepolicy.mk)
@@ -10,8 +10,6 @@ PRODUCT_MANUFACTURER := google
 # Bootanimation
 TARGET_BOOT_ANIMATION_RES := 1080
 
-# APN
-PRODUCT_PACKAGES += apns-conf.xml
 
 #Oplus fingerprint
 $(call soong_config_set,surfaceflinger,udfps_lib,//hardware/oplus:libudfps_extension.oplus)
diff --git a/lineage_arm64_bgN4.mk b/lineage_arm64_bgN4.mk
index 20e52c5..5109cb7 100644
--- a/lineage_arm64_bgN4.mk
+++ b/lineage_arm64_bgN4.mk
@@ -10,7 +10,7 @@ PRODUCT_BRAND := google
 PRODUCT_MODEL := Generic System
 
 # Overwrite the inherited "emulator" characteristics
-PRODUCT_CHARACTERISTICS := device
+PRODUCT_CHARACTERISTICS := tablet
 
 LINEAGE_BUILDTYPE := GAPPS
 LINEAGE_BUILD := GSI
-- 
2.53.0

