From 60d494fd2f1e5b9dd0321373ad6f9739d157b608 Mon Sep 17 00:00:00 2001
From: lionelpnt <lionelpnt@users.noreply.github.com>
Date: Thu, 26 Nov 2026 10:46:21 +0100
Subject: [PATCH] rc: add explicit user root for Android 17 host_init_verifier

---
 cmds/Android.bp            | 48 --------------------------------------
 cmds/evgrab.rc             |  1 +
 cmds/oplus-alert-slider.rc |  1 +
 files/adbd.rc              |  1 +
 ota/phh-ota.rc             |  2 ++
 remote/phh-remotectl.rc    |  1 +
 su/su.rc                   |  1 +
 vndk.rc                    |  3 +++
 8 files changed, 10 insertions(+), 48 deletions(-)

diff --git a/cmds/Android.bp b/cmds/Android.bp
index 0cd78f6..acf9836 100644
--- a/cmds/Android.bp
+++ b/cmds/Android.bp
@@ -1,15 +1,3 @@
-cc_binary {
-	name: "lightsctl",
-	srcs: [
-		"lightsctl.cpp",
-	],
-	shared_libs: [
-		"android.hardware.light@2.0",
-		"libutils",
-		"libhidlbase",
-	],
-}
-
 cc_binary {
 	name: "op-fp",
 	srcs: [
@@ -103,30 +91,6 @@ cc_binary {
 	],
 }
 
-cc_binary {
-	name: "lightsctl-sec",
-	srcs: [
-		"lightsctl-sec.cpp",
-	],
-	shared_libs: [
-		"vendor.samsung.hardware.light@2.0",
-		"libutils",
-		"libhidlbase",
-	],
-}
-
-cc_binary {
-	name: "lightsctl-seh",
-	srcs: [
-		"lightsctl-seh.cpp",
-	],
-	shared_libs: [
-		"vendor.samsung.hardware.light@3.0",
-		"libutils",
-		"libhidlbase",
-	],
-}
-
 cc_binary {
 	name: "xiaomi-motor",
 	srcs: [
@@ -167,18 +131,6 @@ cc_binary {
 	],
 }
 
-cc_binary {
-	name: "lightsctl-huawei",
-	srcs: [
-		"lightsctl-huawei.cpp",
-	],
-	shared_libs: [
-		"vendor.huawei.hardware.light@2.0",
-		"libutils",
-		"libhidlbase",
-	],
-}
-
 cc_binary {
 	name: "asus-motor",
 	srcs: [
diff --git a/cmds/evgrab.rc b/cmds/evgrab.rc
index adf0ff4..67f3494 100644
--- a/cmds/evgrab.rc
+++ b/cmds/evgrab.rc
@@ -2,6 +2,7 @@ on property:sys.boot_completed=1
     start phh_evgrab
 
 service phh_evgrab /system/bin/evgrab
+    user root
     seclabel u:r:phhsu_daemon:s0
     disabled
     oneshot
diff --git a/cmds/oplus-alert-slider.rc b/cmds/oplus-alert-slider.rc
index e895b5a..5476af4 100644
--- a/cmds/oplus-alert-slider.rc
+++ b/cmds/oplus-alert-slider.rc
@@ -1,4 +1,5 @@
 service phhoplus-alert-slider /system/bin/oplus-alert-slider
+    user root
     seclabel u:r:phhsu_daemon:s0
     oneshot
     class main
diff --git a/files/adbd.rc b/files/adbd.rc
index 55b3311..f3baf2e 100644
--- a/files/adbd.rc
+++ b/files/adbd.rc
@@ -1,4 +1,5 @@
 service adbd_system /system/bin/adbd --root_seclabel=u:r:su:s0
+    user root
 	class core
 	socket adbd stream 660 system system
 	disabled
diff --git a/ota/phh-ota.rc b/ota/phh-ota.rc
index c6c5814..d09d614 100644
--- a/ota/phh-ota.rc
+++ b/ota/phh-ota.rc
@@ -1,9 +1,11 @@
 service phh-ota-make /system/bin/phh-ota new-slot
+    user root
 	seclabel u:r:phhsu_daemon:s0
 	disabled
 	oneshot
 
 service phh-ota-switch /system/bin/phh-ota switch-slot
+    user root
 	seclabel u:r:phhsu_daemon:s0
 	disabled
 	oneshot
diff --git a/remote/phh-remotectl.rc b/remote/phh-remotectl.rc
index 3e7aec1..dbfda94 100644
--- a/remote/phh-remotectl.rc
+++ b/remote/phh-remotectl.rc
@@ -10,4 +10,5 @@ on property:persist.sys.phh.remote=false
 
 
 service phh-remotectl /system/bin/phh-remotectl.sh
+    user root
    seclabel u:r:phhsu_daemon:s0
diff --git a/su/su.rc b/su/su.rc
index 935bdde..70d76ea 100644
--- a/su/su.rc
+++ b/su/su.rc
@@ -1,2 +1,3 @@
 service sudaemon /system/bin/phh-su --daemon
+    user root
     class main
diff --git a/vndk.rc b/vndk.rc
index e3e6d11..a37db73 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -13,10 +13,12 @@ on early-boot
     exec - root -- /system/bin/phh-on-data.sh
 
 service phh_on_boot /system/bin/phh-on-boot.sh
+    user root
     oneshot
     disabled
 
 service power_mode_monitor /system/bin/power-mode-monitor.sh
+    user root
     oneshot
     disabled
     seclabel u:r:phhsu_daemon:s0
@@ -131,6 +133,7 @@ on property:persist.sys.phh.dynamic_fps=*
 
 # Set watchdog timer to 30 seconds and pet it every 10 seconds to get a 20 second margin
 service watchdogd-gsi /system/bin/watchdogd 10 20
+    user root
     class core
     oneshot
     disabled
-- 
2.53.0

