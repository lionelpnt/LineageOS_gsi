From 877899a813c8d72d90fe7cc4c11577ee4a61123c Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Wed, 23 Feb 2022 17:37:47 -0500
Subject: [PATCH] Let system override ro.apex.updatable

APEX are broken because of a kernel bug in Android 10 devices
So we have system set ro.apex.updatable = false
However, vendor can override system, which prevents us from setting this
to false
So, ignore the override policy for this prop

Change-Id: I9952bf9c5a4f42eab602b4ef1284f2d56948c801
---
 init/property_service.cpp | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/init/property_service.cpp b/init/property_service.cpp
index 89adf33..3098817 100644
--- a/init/property_service.cpp
+++ b/init/property_service.cpp
@@ -803,12 +803,22 @@ static void LoadProperties(char* data, const char* filter, const char* filename,
             std::string error;
             if (CheckPermissions(key, *expanded_value, context, cr, &error) == PROP_SUCCESS) {
                 auto it = properties->find(key);
+                std::string new_value = *expanded_value;
+                if (strcmp("ro.apex.updatable", key) == 0) {
+                    new_value = "true";
+                }
                 if (it == properties->end()) {
-                    (*properties)[key] = std::move(*expanded_value);
-                } else if (it->second != *expanded_value) {
+                    (*properties)[key] = std::move(new_value);
+                } else if (it->second != new_value) {
                     LOG(WARNING) << "Overriding previous property '" << key << "':'" << it->second
-                                 << "' with new value '" << *expanded_value << "'";
-                    it->second = std::move(*expanded_value);
+                                 << "' with new value '" << new_value << "'";
+                    if (strcmp("ro.apex.updatable", key) == 0) {
+                        LOG(WARNING) << "... Ignored apex";
+                    } else if (strstr(key, "adb") || strstr(key, "secure") || strstr(key, "ro.logd.kernel")) {
+                        LOG(WARNING) << "... Ignored";
+                    } else {
+                        it->second = std::move(new_value);
+                    }
                 }
             } else {
                 LOG(ERROR) << "Do not have permissions to set '" << key << "' to '"
-- 
2.53.0

